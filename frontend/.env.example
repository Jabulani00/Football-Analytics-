# OddAlerts Football Data API token.
# Get yours from https://oddalerts.com and copy frontend/.env.example -> frontend/.env
#
# ODDALERTS_TOKEN          -> used by the server-side proxy (web). Keep secret.
# EXPO_PUBLIC_ODDALERTS_TOKEN -> used for direct calls on native (iOS/Android) dev.
#
# On Vercel, set ODDALERTS_TOKEN in Project Settings -> Environment Variables.

ODDALERTS_TOKEN=your_oddalerts_token_here
EXPO_PUBLIC_ODDALERTS_TOKEN=your_oddalerts_token_here

# Optional overrides:
# EXPO_PUBLIC_ODDALERTS_PROXY=/oddalerts
# Absolute URL sends the native app through the same proxy (token stays on the server).
# Web always uses same-origin /oddalerts.
# EXPO_PUBLIC_ODDALERTS_PROXY=https://your-deployment.example/oddalerts
# EXPO_PUBLIC_ODDALERTS_BASE_URL=https://data.oddalerts.com/api

# Short-lived complete-response cache on the proxy. CACHE_ENABLED=false passes through.
# CACHE_ENABLED=true
# ODDALERTS_UPSTREAM_CONCURRENCY=12
# ODDALERTS_CACHE_MAX_BYTES=8000000
# ODDALERTS_CACHE_TTLS={"fixtures/live":{"freshMs":10000,"staleMs":10000}}
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Club badges (logos) via TheSportsDB. The public test key "123" works out of
# the box; set your own key for higher rate limits (https://www.thesportsdb.com/api.php).
# THESPORTSDB_KEY              -> used by the server-side /teamlogo proxy (web).
# EXPO_PUBLIC_THESPORTSDB_KEY  -> used for direct lookups on native.
# THESPORTSDB_KEY=123
# EXPO_PUBLIC_THESPORTSDB_KEY=123

# API-Football (api-sports.io) — goal scorers, assists, cards, subs on match summary.
# Free tier: 100 requests/day. Register at https://dashboard.api-football.com/register
# API_FOOTBALL_KEY              -> server proxy (web). Keep secret.
# EXPO_PUBLIC_API_FOOTBALL_KEY  -> native direct calls.
# API_FOOTBALL_KEY=your_api_football_key_here
# EXPO_PUBLIC_API_FOOTBALL_KEY=your_api_football_key_here

# Supabase — Hollywood hunt store (Section 10).
# Schema: supabase/migrations/20260911090000_hollywood_hunt.sql
#
# The ANON key is safe in the client bundle: RLS on hw_event / hw_change /
# hw_crawl_state allows it to read and nothing else.
# The SERVICE_ROLE key bypasses RLS entirely — crawler only, server-side.
# NEVER give it an EXPO_PUBLIC_ name; that ships it to the browser.
EXPO_PUBLIC_SUPABASE_URL=https://zymspnykcnqczqdnernb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_HOLLYWOOD_HUNT_URL=https://zymspnykcnqczqdnernb.supabase.co/functions/v1/hollywood-hunt
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function only (set with `supabase secrets set`, never in the client):
# HUNT_CRON_SECRET=generate-a-long-random-value
